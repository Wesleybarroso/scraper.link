# ========================================
# Configuração da API de Scraping
# ========================================

# Chave da API Groq (para fallback com IA)
# Obtenha em: https://console.groq.com/
GROQ_API_KEY=sua_chave_groq_aqui

# Ativar/desativar fallback com IA
# Valores: true ou false (padrão: true)
USE_IA_FALLBACK=true

# Chaves de APIs futuras (suporte extensível)
OPENAI_API_KEY=sua_chave_openai_aqui
GOOGLE_API_KEY=sua_chave_google_aqui

# ========================================
# Configuração do Servidor
# ========================================

# Nível de logging
# Valores: DEBUG, INFO, WARNING, ERROR (padrão: INFO)
LOG_LEVEL=INFO

# Porta da aplicação
PORT=8000

# Host da aplicação
HOST=0.0.0.0

# Modo debug
DEBUG=false
