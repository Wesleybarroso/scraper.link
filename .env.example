# ========================================
# Configuração da API de Scraping
# ========================================

# Escolha qual IA usar para fallback
# Opções: groq, openai, openrouter, google
# Padrão: groq (recomendado, grátis e rápido)
IA_PROVIDER=groq

# -------- GROQ (Recomendado - Grátis) --------
# Obtenha em: https://console.groq.com/
# - Grátis
# - Rápido (milissegundos)
# - Sem cartão de crédito
GROQ_API_KEY=sua_chave_groq_aqui

# -------- OPENAI (ChatGPT) --------
# Obtenha em: https://platform.openai.com/api-keys
# - Pago (mas com créditos iniciais grátis)
# - Modelo: gpt-4-mini ou gpt-3.5-turbo
OPENAI_API_KEY=sua_chave_openai_aqui
OPENAI_MODEL=gpt-4-mini

# -------- OPENROUTER (Agregador - Múltiplos Modelos) --------
# Obtenha em: https://openrouter.ai/
# - Pago mas barato
# - Suporta Claude, GPT-4, Llama, etc.
# - Ótimo para escolher melhor custo/benefício
OPENROUTER_API_KEY=sua_chave_openrouter_aqui
OPENROUTER_MODEL=meta-llama/llama-2-70b-chat

# -------- GOOGLE (Gemini) --------
# Obtenha em: https://ai.google.dev/
# - Grátis com limite generoso
# - Modelo: gemini-1.5-flash (recomendado)
GOOGLE_API_KEY=sua_chave_google_aqui
GOOGLE_MODEL=gemini-1.5-flash

# -------- Configurações Gerais --------
# Ativar/desativar fallback com IA
# Valores: true ou false (padrão: true)
USE_IA_FALLBACK=true

# ========================================
# Configuração do Servidor
# ========================================

# Nível de logging
# Valores: DEBUG, INFO, WARNING, ERROR (padrão: INFO)
LOG_LEVEL=INFO

# Porta da aplicação
PORT=8000

# Host da aplicação
HOST=0.0.0.0

# Modo debug
DEBUG=false
