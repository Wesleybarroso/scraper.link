# ===== NopeCHA (opcional, mas recomendado) =====
NOPECHA_KEY=
NOPECHA_PATH=./nopecha-extension

BROWSER_HEADLESS=true
BROWSER_USER_DATA=/tmp/scraper-link-profile

# ===== Fallback IA =====
USE_IA_FALLBACK=true
IA_PROVIDER=groq
GROQ_API_KEY=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.1-70b-instruct

GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-1.5-flash

# ===== Fallback aiograpi (Instagram) =====
USE_AIOGRAPI_FALLBACK=true
IG_USERNAME=
IG_PASSWORD=
